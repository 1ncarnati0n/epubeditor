{
	"name": "epubeditor",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "BODY_SIZE_LIMIT=200M HOST=127.0.0.1 PORT=5173 ORIGIN=http://localhost:5173 node build",
		"fonts": "node scripts/fetch-fonts.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"smoke:codex": "npm run build && node scripts/codex-smoke.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"cheerio": "^1.2.0",
		"fflate": "^0.8.3",
		"subset-font": "^2.5.0",
		"zod": "^4.4.3"
	}
}
